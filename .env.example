# 이 파일을 .env로 복사한 뒤 값을 채운다. (.env는 Git에 올라가지 않는다)
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash/Mac/Linux:  cp .env.example .env

# --- DB ---
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me

# --- Agent ---
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급. 비워 두면 규칙 기반으로만 동작한다.
GEMINI_API_KEY=
# 무료로 쓸 수 있는 모델 이름은 AI Studio에서 확인 후 바꿀 수 있다.
GEMINI_MODEL=gemini-3.8-flash
# Slack 앱 → Incoming Webhooks에서 발급한 URL
SLACK_WEBHOOK_URL=

# 로그 확인 주기(초), 같은 장애 재알림 대기 시간(초)
AGENT_INTERVAL_SEC=30
AGENT_COOLDOWN_SEC=300
